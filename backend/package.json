{
  "name": "tukar-buku-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REST API untuk aplikasi FestivalTukarBuku (Express + MongoDB)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/seed.ts",
    "smoke": "tsx src/scripts/smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.4",
    "multer": "^2.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "mongodb-memory-server@11.3.0": true
  }
}
